# =============================================================================
# configs/smoke.env — tunable knobs for the Gemma-3-12B LoRA smoke test.
# Source this before running, or pass the variables through `docker exec -e`.
#
#   set -a; source configs/smoke.env; set +a
# =============================================================================

# Container / image
IMAGE=nvcr.io/nvidia/nemo:26.08         # bundles Megatron-Bridge 0.6.1
CONTAINER=mbridge

# Host HuggingFace cache (mounted read/write into the container at /hf_cache)
HF_CACHE=/ephemeral/cache/huggingface

# Model checkpoints
GEMMA_MODEL_ID=google/gemma-3-12b-pt    # multimodal base weights (LoRA target)
GEMMA_PROCESSOR_ID=google/gemma-3-12b-it # instruct processor (has chat template)

# Smoke-test hyperparameters
SMOKE_SEQ_LEN=512                        # short sequence => fast + low memory
SMOKE_TRAIN_ITERS=3                      # a few steps only
SMOKE_OUT_DIR=/workspace/outputs/gemma3vl_12b_lora_smoke
